# Omega Model Registry Freshness Checker - Timer Unit
#
# Runs hourly with randomized delay to avoid thundering herd
# Critical tier runs daily at 06:00 UTC

[Unit]
Description=Hourly Omega Model Registry Freshness Check
Requires=omega-freshness-checker.service

[Timer]
# Run hourly with random delay up to 15 minutes
OnCalendar=hourly
Persistent=true
RandomizedDelaySec=15min

# Also run critical tier daily at 06:00 UTC
OnCalendar=*-*-* 06:00:00
Persistent=true

# Accuracy
AccuracySec=1min

[Install]
WantedBy=timers.target