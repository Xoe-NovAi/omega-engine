# Omega Engine — TTY Agent Systemd Service Templates
# 
# Install:
#   sudo cp omega-tty-agent@.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#
# Enable/Start:
#   sudo systemctl enable --now omega-tty-agent@researcher-tty3.service
#   sudo systemctl enable --now omega-tty-agent@roc_racoon-tty4.service
#   sudo systemctl enable --now omega-tty-agent@kali-tty5.service
#   sudo systemctl enable --now omega-tty-agent@observability-tty6.service
#
# Status:
#   sudo systemctl status omega-tty-agent@researcher-tty3.service
#   journalctl -u omega-tty-agent@researcher-tty3.service -f

[Unit]
Description=Omega Engine TTY Agent: %i
Documentation=https://github.com/xoe-novai/omega-engine
After=systemd-vconsole-setup.service
Wants=systemd-vconsole-setup.service
# Ensure VT is available
ConditionPathExists=/dev/%I
# Only start if not in container
ConditionVirtualization=!container

[Service]
Type=notify
# Run as dedicated user (create: sudo useradd -r -s /sbin/nologin -G tty omega)
User=omega
Group=tty
SupplementaryGroups=tty

# Working directory
WorkingDirectory=/home/arcana-novai/Documents/Xoe-NovAi/omega-engine

# Environment
Environment=OMEGA_DATA_DIR=/home/arcana-novai/Documents/Xoe-NovAi/omega-engine/data
Environment=PYTHONPATH=/home/arcana-novai/Documents/Xoe-NovAi/omega-engine/src
Environment=PYTHONUNBUFFERED=1

# TTY Configuration - CRITICAL SETTINGS
# StandardInput=tty-force: Connect stdin to the TTY, acquire VT_PROCESS mode
StandardInput=tty-force
StandardOutput=journal
StandardError=journal

# TTY device (e.g., tty3, tty4, tty5, tty6)
TTYPath=/dev/%I
TTYReset=yes
TTYVHangup=yes
TTYVTDisallocate=yes

# VT_PROCESS mode is automatically acquired by systemd when StandardInput=tty-force
# The agent can then use VT ioctls to manage the VT

# Security Hardening
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=read-only
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM

# Capabilities (minimal)
CapabilityBoundingSet=CAP_DAC_OVERRIDE CAP_SYS_TTY_CONFIG
AmbientCapabilities=CAP_DAC_OVERRIDE CAP_SYS_TTY_CONFIG

# Resource Limits
MemoryMax=2G
CPUQuota=200%
TasksMax=100

# Restart Policy
Restart=on-failure
RestartSec=10
StartLimitIntervalSec=60
StartLimitBurst=3

# Notify systemd when ready
NotifyAccess=main

# Exec
ExecStart=/home/arcana-novai/Documents/Xoe-NovAi/omega-engine/.venv/bin/python -m src.omega.agents.tty_agent \
    --entity %i \
    --tty /dev/%I \
    --data-dir /home/arcana-novai/Documents/Xoe-NovAi/omega-engine/data

# Pre-start: ensure VT is allocated
ExecStartPre=/bin/bash -c 'if ! systemd-tty-ask-password-agent --query 2>/dev/null; then exit 0; fi'

[Install]
WantedBy=multi-user.target
Alias=omega-tty-agent-%i.service