[Unit]
Description=First-boot WARP Registration for Instance %i
Documentation=file:///home/arcana-novai/Documents/Xoe-NovAi/omega-engine/docs/research/warp_proxy_pool/WARP_PROXY_POOL_SPEC.md
After=warp-ns-prep@%i.service
Before=warp-node@%i.service
DefaultDependencies=no

[Service]
Type=oneshot
RemainAfterExit=yes
# Runs on HOST — orchestrates the registration daemon via systemctl
ExecStart=/usr/bin/bash -c '\
  set -euo pipefail; \
  NS="warp_node_%i"; \
  CONF="/var/lib/cloudflare-warp-%i"; \
  DEFAULT="/var/lib/cloudflare-warp"; \
  REG_SVC="warp-reg-svc@%i.service"; \
  \
  echo "[warp-reg] Stopping any existing registration daemon..."; \
  systemctl stop "$${REG_SVC}" 2>/dev/null || true; \
  \
  echo "[warp-reg] Cleaning host registration state..."; \
  /usr/bin/chattr -i "$${DEFAULT}/reg.json" "$${DEFAULT}/conf.json" "$${DEFAULT}/warp.db" \
    "$${DEFAULT}/settings.json" "$${DEFAULT}/final-overrides-settings.json" \
    "$${DEFAULT}/warp.db-wal" "$${DEFAULT}/warp.db-shm" 2>/dev/null || true; \
  rm -rf "$${DEFAULT}/reg.json" "$${DEFAULT}/conf.json" "$${DEFAULT}/warp.db" \
         "$${DEFAULT}/settings.json" "$${DEFAULT}/final-overrides-settings.json" \
         "$${DEFAULT}/warp.db-wal" "$${DEFAULT}/warp.db-shm" \
         "$${CONF}/reg.json" "$${CONF}/conf.json" "$${CONF}/warp.db" \
         "$${CONF}/warp.db-wal" "$${CONF}/warp.db-shm"; \
  \
  echo "[warp-reg] Preparing directories..."; \
  mkdir -p "$${CONF}" "$${DEFAULT}" /run/cloudflare-warp /var/log/cloudflare-warp; \
  chmod 755 /var/log/cloudflare-warp; \
  \
  echo "[warp-reg] Starting registration daemon..."; \
  systemctl start "$${REG_SVC}"; \
  \
  echo "[warp-reg] Polling daemon IPC..."; \
  for i in $(seq 1 60); do \
    if /usr/bin/warp-cli --accept-tos status &>/dev/null; then \
      echo "[warp-reg] Daemon ready."; \
      break; \
    fi; \
    sleep 0.5; \
  done; \
  \
  echo "[warp-reg] Resetting daemon state..."; \
  /usr/bin/warp-cli --accept-tos settings reset; \
  \
  echo "[warp-reg] Registering new identity..."; \
  /usr/bin/warp-cli --accept-tos registration new; \
  \
  echo "[warp-reg] Copying registration to instance config..."; \
  cp -r "$${DEFAULT}"/* "$${CONF}"/; \
  \
  echo "[warp-reg] Stopping registration daemon..."; \
  systemctl stop "$${REG_SVC}"; \
  \
  echo "[warp-reg] Registration complete for %i."; \
'

# Capabilities for systemctl operations
CapabilityBoundingSet=CAP_NET_ADMIN CAP_SYS_ADMIN
AmbientCapabilities=CAP_NET_ADMIN CAP_SYS_ADMIN
RestrictAddressFamilies=AF_INET AF_UNIX AF_NETLINK
NoNewPrivileges=true

TimeoutStartSec=300

[Install]
WantedBy=multi-user.target