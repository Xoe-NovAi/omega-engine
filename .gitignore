*.pyc
*.pyo
*.pyd

# ── Virtual Environments ─────────────────────────────────────────────
.venv/
venv/
env/
virtualenv/

# ── Environment & Secrets ────────────────────────────────────────────
.env
.env.local
*.env*
.env.*
config/github_webhook_secret

# ── Build Artifacts ──────────────────────────────────────────────────
*.egg-info/
dist/
build/
*.egg
*.whl
*.tar.gz

# ── Downloaded Models (large binaries, not source) ────────────────────
models/

# ── Test & Cache ─────────────────────────────────────────────────────
.pytest_cache/
.ruff_cache/
.mypy_cache/
.hypothesis/
.coverage
.coverage.*
htmlcov/
coverage.xml
.tox/

# ── IDE & Editor ─────────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
*~

# ── OS Files ─────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini

# ── Docker ───────────────────────────────────────────────────────────
.docker/

# ── Session Artifacts ───────────────────────────────────────────────
