OCCE-*.md
open-code-*.md
opencode.json.bak

# ── Web Research Caches ──────────────────────────────────────────────
.firecrawl/

# ── Temp & Ad-Hoc Files ──────────────────────────────────────────────
tmp_*
*.bak
mcp_test.py
test_discovery.py
check_hivemind.py
Screenshot*.png

