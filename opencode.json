{
  "$schema": "https://opencode.ai/config.json",
  "plugin": ["opencode-antigravity-auth@latest"],
  "permission": {
    "external_directory": {
      "/home/arcana-novai/Documents/Xoe-NovAi/**": "allow",
      "/media/arcana-novai/**": "allow",
      "/home/arcana-novai/archive/**": "allow",
      "/home/arcana-novai/Documents/docs-backup/**": "allow",
      "/home/arcana-novai/Documents/docs_1/**": "allow",
      "/home/arcana-novai/Documents/Archives/**": "allow",
      "/home/arcana-novai/Documents/xnaif-files/**": "allow",
      "/home/arcana-novai/.lmstudio/**": "allow",
      "/home/arcana-novai/.ollama/**": "allow",
      "/home/arcana-novai/.config/opencode/**": "allow",
      "/tmp/omega/**": "allow",
      "/*": "allow"
    }
  },
  "instructions": [
    "SOVEREIGN_MANDATES.md",
    "ORACLE_STACK.md",
    "docs/archive/MASTER_SYNTHESIS_AND_ROADMAP_2026-05-30.md",
    "docs/strategy/SOVEREIGN_ARK_BLUEPRINT.md",
    "CREDITS.md"
  ],
  "mcp": {
    "omega-hub": {
      "type": "streamable-http",
      "url": "http://127.0.0.1:8016/mcp",
      "enabled": true
    },
    "searxng": {
      "type": "remote",
      "url": "http://127.0.0.1:8017/mcp",
      "enabled": true
    },
    "firecrawl": {
      "type": "remote",
      "url": "http://127.0.0.1:8015/sse",
      "enabled": false
    },
    "exa": {
      "type": "streamable-http",
      "url": "https://mcp.exa.ai/mcp?tools=web_search_exa,web_fetch_exa",
      "headers": {
        "x-api-key": "${EXA_API_KEY}"
      },
      "enabled": true
    }
  },
  "compaction": {
    "auto": true,
    "prune": true,
    "tail_turns": 3,
    "preserve_recent_tokens": 40000,
    "reserved": 10000
  },
  "provider": {
    "lmstudio": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "LM Studio (Local)",
      "options": {
        "baseURL": "http://localhost:1234/v1",
        "apiKey": "sk-local"
      },
      "models": {
        "qwen3-4b-thinking": {
          "id": "qwen3-4b-thinking",
          "name": "Qwen3 4B Thinking (local)",
          "limit": {
            "context": 8192,
            "output": 4096
          }
        },
        "qwen3-1.7b": {
          "id": "qwen3-1.7b",
          "name": "Qwen3 1.7B (local)",
          "limit": {
            "context": 4096,
            "output": 2048
          }
        },
        "qwen3-1.7b-q6_k": {
          "id": "qwen3-1.7b-q6_k",
          "name": "Qwen3 1.7B Q6_K (local)",
          "limit": {
            "context": 8192,
            "output": 4096
          }
        },
        "phi-4-mini": {
          "id": "phi-4-mini",
          "name": "Phi-4 Mini (local)",
          "limit": {
            "context": 16384,
            "output": 4096
          }
        },
        "krikri-8b": {
          "id": "krikri-8b",
          "name": "Krikri 8B (local)",
          "limit": {
            "context": 16384,
            "output": 4096
          }
        },
        "deepseek-r1-qwen3-8b": {
          "id": "deepseek-r1-qwen3-8b",
          "name": "DeepSeek R1 Qwen3 8B (local)",
          "limit": {
            "context": 8192,
            "output": 4096
          }
        }
      }
    },
    "google": {
      "models": {
        "antigravity-gemini-3-pro": {
          "name": "Gemini 3 Pro (Antigravity)",
          "limit": { "context": 1048576, "output": 65535 },
          "modalities": { "input": ["text", "image", "pdf"], "output": ["text"] },
          "variants": {
            "low": { "thinkingLevel": "low" },
            "high": { "thinkingLevel": "high" }
          }
        },
        "antigravity-gemini-3.1-pro": {
          "name": "Gemini 3.1 Pro (Antigravity)",
          "limit": { "context": 1048576, "output": 65535 },
          "modalities": { "input": ["text", "image", "pdf"], "output": ["text"] },
          "variants": {
            "low": { "thinkingLevel": "low" },
            "high": { "thinkingLevel": "high" }
          }
        },
        "antigravity-gemini-3-flash": {
          "name": "Gemini 3 Flash (Antigravity)",
          "limit": { "context": 1048576, "output": 65536 },
          "modalities": { "input": ["text", "image", "pdf"], "output": ["text"] },
          "variants": {
            "minimal": { "thinkingLevel": "minimal" },
            "low": { "thinkingLevel": "low" },
            "medium": { "thinkingLevel": "medium" },
            "high": { "thinkingLevel": "high" }
          }
        },
        "antigravity-claude-sonnet-4-6": {
          "name": "Claude Sonnet 4.6 (Antigravity)",
          "limit": { "context": 200000, "output": 64000 },
          "modalities": { "input": ["text", "image", "pdf"], "output": ["text"] }
        },
        "antigravity-claude-opus-4-6-thinking": {
          "name": "Claude Opus 4.6 Thinking (Antigravity)",
          "limit": { "context": 200000, "output": 64000 },
          "modalities": { "input": ["text", "image", "pdf"], "output": ["text"] },
          "variants": {
            "low": { "thinkingConfig": { "thinkingBudget": 8192 } },
            "max": { "thinkingConfig": { "thinkingBudget": 32768 } }
          }
        },
        "gemini-2.5-flash": {
          "name": "Gemini 2.5 Flash (Gemini CLI)",
          "limit": { "context": 1048576, "output": 65536 },
          "modalities": { "input": ["text", "image", "pdf"], "output": ["text"] }
        },
        "gemini-2.5-pro": {
          "name": "Gemini 2.5 Pro (Gemini CLI)",
          "limit": { "context": 1048576, "output": 65536 },
          "modalities": { "input": ["text", "image", "pdf"], "output": ["text"] }
        },
        "gemini-3-flash-preview": {
          "name": "Gemini 3 Flash Preview (Gemini CLI)",
          "limit": { "context": 1048576, "output": 65536 },
          "modalities": { "input": ["text", "image", "pdf"], "output": ["text"] }
        },
        "gemini-3-pro-preview": {
          "name": "Gemini 3 Pro Preview (Gemini CLI)",
          "limit": { "context": 1048576, "output": 65535 },
          "modalities": { "input": ["text", "image", "pdf"], "output": ["text"] }
        }
      }
    }
  },
  "agent": {
    "makali": {
      "mode": "all",
      "description": "MaKaLi Parallel Council \u2014 decomposes query, dispatches Ma'at+Lilith in parallel, synthesizes (D117)",
      "instructions": [
        ".opencode/agents/makali.md",
        "docs/strategy/SOVEREIGN_ARK_BLUEPRINT.md"
      ]
    },
    "jem": {
      "mode": "all",
      "description": "Research Orchestrator \u2014 3-tier pipeline with inline KBs (Discovery/Synthesis/Verification), self-dispatch pattern",
      "instructions": [
        ".opencode/agents/jem.md"
      ]
    },
    "doom_guy": {
      "mode": "all",
      "description": "Sovereign id Software Architect \u2014 WAD translation & performance",
      "instructions": [
        ".opencode/agents/doom_guy.md",
        "CREDITS.md"
      ]
    },
    "roc_racoon": {
      "mode": "all",
      "description": "Sovereign Miner \u2014 Legacy archaeology & pattern extraction",
      "instructions": [
        ".opencode/agents/roc_racoon.md"
      ]
    },
    "researcher": {
      "mode": "all",
      "description": "Sovereign Master Researcher \u2014 Polymathic Council for deep research, dialectic synthesis, and knowledge base curation",
      "instructions": [
        ".opencode/agents/researcher.md"
      ]
    },
    "kali": {
      "mode": "all",
      "description": "Grand Oversight \u2014 Sees all, delegates to Ma'at/Lilith, destroys drift",
      "instructions": [
        ".opencode/agents/kali.md"
      ]
    },
    "maat": {
      "mode": "all",
      "description": "Light Oversoul \u2014 Governs P1-P5 (build side), delegates to pillar",
      "instructions": [
        ".opencode/agents/maat.md"
      ]
    },
    "lilith": {
      "mode": "all",
      "description": "Dark Oversoul \u2014 Governs P6-P10 (run side), delegates to pillar",
      "instructions": [
        ".opencode/agents/lilith.md"
      ]
    },
    "verity": {
      "mode": "subagent",
      "description": "Sovereign Verity \u2014 Unified Sentry (compliance/audit) + Scribe (gnosis distillation). Sprint C consolidation.",
      "instructions": [
        ".opencode/agents/verity.md"
      ]
    },
    "pillar": {
      "mode": "all",
      "description": "Slot-based domain agent \u2014 parameterized by --slot PX for any Pillar domain",
      "instructions": [
        ".opencode/agents/pillar.md"
      ]
    },
    "john_carmack": {
      "mode": "all",
      "description": "Ultimate Technical Consultant \u2014 id Software heritage, systems architecture, sovereign engineering",
      "instructions": [
        ".opencode/agents/john_carmack.md",
        "CREDITS.md"
      ]
    }
  }
}