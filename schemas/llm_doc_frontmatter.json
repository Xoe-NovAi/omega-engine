{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": [
    "schema_version",
    "document_type",
    "document_id",
    "title",
    "status",
    "version",
    "date",
    "owner",
    "tags",
    "priority",
    "depends_on",
    "blocks",
    "acceptance_gates",
    "cross_references",
    "llm_metadata"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.0",
      "description": "Schema version for validation"
    },
    "document_type": {
      "type": "string",
      "enum": [
        "sprint_plan",
        "architecture",
        "spec",
        "protocol",
        "guide",
        "reference",
        "ticket_page",
        "research_index"
      ],
      "description": "Type of document for processing rules"
    },
    "document_id": {
      "type": "string",
      "pattern": "^[a-z0-9-]+$",
      "description": "Unique identifier (kebab-case)"
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "description": "Human-readable title"
    },
    "status": {
      "type": "string",
      "enum": ["ACTIVE", "DRAFT", "DEPRECATED", "ARCHIVED", "PLANNED"],
      "description": "Document lifecycle status"
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$",
      "description": "Semantic version"
    },
    "date": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
      "description": "ISO 8601 date"
    },
    "owner": {
      "type": "string",
      "description": "Responsible entity/agent"
    },
    "tags": {
      "type": "array",
      "items": { "type": "string" },
      "minItems": 1,
      "description": "Searchable tags"
    },
    "priority": {
      "type": "string",
      "enum": ["P0", "P1", "P2", "P3"],
      "description": "Priority level"
    },
    "depends_on": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Document IDs this depends on"
    },
    "blocks": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Document IDs this blocks"
    },
    "acceptance_gates": {
      "type": "array",
      "items": { "type": "string" },
      "minItems": 1,
      "description": "Copy-paste verifiable acceptance criteria"
    },
    "cross_references": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Related document paths"
    },
    "llm_metadata": {
      "type": "object",
      "required": [
        "token_budget",
        "chunk_strategy",
        "answer_first_sections",
        "self_contained_code"
      ],
      "properties": {
        "token_budget": {
          "type": "integer",
          "minimum": 500,
          "description": "Target token budget for this document"
        },
        "chunk_strategy": {
          "type": "string",
          "enum": [
            "section_per_ticket",
            "section_per_component",
            "flat",
            "section_per_topic"
          ],
          "description": "How to chunk for RAG/vector storage"
        },
        "answer_first_sections": {
          "type": "boolean",
          "description": "Whether sections use answer-first format"
        },
        "self_contained_code": {
          "type": "boolean",
          "description": "Whether code blocks are self-contained"
        },
        "modular_pages": {
          "type": "boolean",
          "default": false,
          "description": "Whether document is split into modular pages"
        },
        "llms_txt_generated": {
          "type": "boolean",
          "default": false,
          "description": "Whether llms.txt/llms-full.txt generated"
        }
      }
    }
  }
}