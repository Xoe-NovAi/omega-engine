{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "parallel-search": {
      "type": "remote",
      "url": "https://search.parallel.ai/mcp",
      "enabled": true,
      "oauth": false,
      "headers": {
        "Authorization": "Bearer {env:PARALLEL_API_KEY}"
      },
      "timeout": 120000
    },
    "mempalace": {
      "type": "local",
      "command": [
        "/home/xnai/WanderGround/.venv/bin/mempalace-mcp",
        "--palace",
        "/home/xnai/WanderGround/mempalace"
      ],
      "enabled": true
    }
  },
  "agent": {
    "build": {
      "mode": "primary",
      "permission": {
        "task": {
          "asus_plan": "allow",
          "grokster": "allow",
          "kali": "allow",
          "makali": "allow",
          "*": "deny"
        }
      }
    },
    "kali": {
      "mode": "subagent",
      "description": "Council Synthesis / Federation Law",
      "prompt": "{file:~/.config/opencode/prompts/kali.md}",
      "tools": {
        "parallel-search": true
      }
    },
    "makali": {
      "mode": "subagent",
      "description": "AMD Architecture Vault (Zen 2 Only)",
      "prompt": "{file:~/.config/opencode/prompts/makali.md}",
      "tools": {
        "parallel-search": true
      }
    }
  },
  "subagent_depth": 1
}
