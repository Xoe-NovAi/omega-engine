// 🔱 Test plugin — verify event system works
export const TestEventPlugin = async ({ project, client, $, directory, worktree }) => {
  console.log("[test-event] Plugin initialized!");

  // Also log via Bun's stdout which goes to server logs
  return {
    event: async ({ event }) => {
      console.log(`[test-event] Event received: type=${event.type}`);
      
      // Try session.idle too (fires every turn)
      if (event.type === "session.idle") {
        console.log("[test-event] session.idle fired!");
        if (client?.app?.log) {
          await client.app.log({
            body: {
              service: "test-event",
              level: "info",
              message: `test-event: session.idle received`,
            },
          });
        }
      }
      
      if (event.type === "session.compacted") {
        console.log("[test-event] session.compacted fired!");
        if (client?.app?.log) {
          await client.app.log({
            body: {
              service: "test-event",
              level: "info",
              message: `test-event: session.compacted received`,
            },
          });
        }
      }
    },
  };
};
