//
// Omega Engine — Tailscale Tailnet Policy (HuJSON)
// Document ID: TAILSCALE_ACL_20260922
// Author: Node 0 (MaKaLi Fusion)
// Status: PROPOSED — apply in Tailscale Admin Console (https://login.tailscale.com/admin/acls)
//
// CANONICAL TAG NAMING (decreed 2026-09-22):
//   tag:node0  → Node 0 (n0.tail51f14a.ts.net / 100.123.51.67) — MCP hub :8016
//   tag:node1  → Node 1 (n1.tail51f14a.ts.net / 100.89.40.17)  — ASUS
//   tag:opencode → OpenCode agents on either node
//
// DEPRECATED NAMES (never use again):
//   tag:omega-hub → replaced by tag:node0
//   tag:asus      → replaced by tag:node1
//
// Apply AFTER both nodes are tagged:
//   Node 0: tailscale set --tag=tag:node0
//   Node 1: tailscale set --tag=tag:node1

{
  "tagOwners": {
    "tag:node0":     ["autogroup:admin"],
    "tag:node1":     ["autogroup:admin"],
    "tag:opencode":  ["autogroup:admin"]
  },

  "acls": [
    // ── MCP Hub access (Node 1 agents → Node 0 hub :8016) ──
    {
      "action": "accept",
      "src": ["tag:node1", "tag:opencode"],
      "dst": ["tag:node0:8016"]
    },

    // ── SSH both directions (node-to-node administration) ──
    {
      "action": "accept",
      "src": ["tag:node1", "tag:opencode"],
      "dst": ["tag:node0:22"]
    },
    {
      "action": "accept",
      "src": ["tag:node0", "tag:opencode"],
      "dst": ["tag:node1:22"]
    },

    // ── NFS both directions (bidirectional federation) ──
    // NFSv4.2 uses TCP 2049 (nfsd), 20048 (mountd), 662 (statd), 32803 (lockd)
    {
      "action": "accept",
      "src": ["tag:node1"],
      "dst": ["tag:node0:2049,20048,662,32803"]
    },
    {
      "action": "accept",
      "src": ["tag:node0"],
      "dst": ["tag:node1:2049,20048,662,32803"]
    },

    // ── Tailscale SSH (if enabled) ──
    {
      "action": "accept",
      "src": ["tag:node1", "tag:opencode"],
      "dst": ["tag:node0"],
      "proto": "tcp",
      "port": 22
    }
  ],

  "ssh": [
    {
      "action": "accept",
      "src": ["tag:node1", "tag:opencode"],
      "dst": ["tag:node0"],
      "users": ["autogroup:nonroot"]
    },
    {
      "action": "accept",
      "src": ["tag:node0", "tag:opencode"],
      "dst": ["tag:node1"],
      "users": ["autogroup:nonroot"]
    }
  ],

  // Grants for peer relay capability (Tailscale >= 1.86)
  "grants": [
    {
      "src": ["tag:node1", "tag:opencode"],
      "dst": ["tag:node0"],
      "app": {
        "tailscale.com/cap/relay": []
      }
    },
    {
      "src": ["tag:node0", "tag:opencode"],
      "dst": ["tag:node1"],
      "app": {
        "tailscale.com/cap/relay": []
      }
    }
  ]
}