{
  "$schema": "https://opencode.ai/config.json",
  "default_agent": "build",
  "permission": {
    "read": "allow",
    "edit": "allow",
    "glob": "allow",
    "grep": "allow",
    "list": "allow",
    "bash": "allow",
    "external_directory": "ask",
    "todowrite": "allow",
    "question": "allow",
    "webfetch": "allow",
    "websearch": "allow",
    "lsp": "allow",
    "doom_loop": "ask",
    "skill": "allow"
  },
  "mcp": {
    "parallel-search": {
      "type": "local",
      "command": [
        "/home/xnai/Documents/Projects/omega-engine-alpha/scripts/parallel_bridge.py"
      ],
      "enabled": true
    },
    "mempalace": {
      "type": "local",
      "command": [
        "/home/xnai/WanderGround/.venv/bin/mempalace-mcp",
        "--palace",
        "/home/xnai/WanderGround/mempalace"
      ]
    },
    "firecrawl": {
      "type": "remote",
      "url": "https://mcp.firecrawl.dev/v2/mcp",
      "enabled": true,
      "oauth": false,
      "headers": {
        "Authorization": "Bearer {env:FIRECRAWL_API_KEY}"
      },
      "timeout": 120000
    }
  },
  "agent": {
    "build": {
      "mode": "primary",
      "permission": {
        "task": {
          "*": "deny",
          "kali": "allow",
          "makali": "allow",
          "lilith": "allow",
          "researcher_humboldt": "allow"
        }
      }
    },
    "researcher_humboldt": {
      "mode": "all",
      "description": "Universal Synthesist / Polymath Explorer (Alexander von Humboldt archetype) — Measure, map, correspond, synthesize across all WanderGround domains",
      "prompt": "{file:~/.config/opencode/prompts/researcher_humboldt.md}"
    }
  },
  "compaction": {
    "auto": true,
    "prune": true
  },
  "subagent_depth": 1
}
