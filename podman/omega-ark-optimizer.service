# 🔱 Omega Engine — Ark Blueprint Optimizer (systemd user service)
# ⬡ OMEGA ⬡ VERITY ⬡ ark_optimizer ⬡ BACKGROUND-SERVICE
#
# Runs scripts/ark_optimizer.py daily. The script is READ-ONLY on all
# sources (Ark Blueprint, OMEGA_ENGINE.md, PIVOT_LOG.md, workbench DB, src/)
# and WRITE-ONLY to data/coordination/ARK_OPTIMIZATION_REPORT.md.
#
# M6 (Podman Sovereignty) compliance note:
#   This is a native systemd USER service (rootless), not a container, so the
#   container-only `UserNS=keep-id` directive does not apply. Running as a
#   rootless user service already executes as host UID 1000 with no privilege
#   escalation and no destructive volume chown — the exact intent of M6.
#   User= is intentionally omitted: rootless user services already run as
#   the invoking user (UID 1000). Setting User=1000 triggers a supplementary-
#   group lookup that EPERMs in the user manager (status=216/GROUP). If
#   wrapped in a Quadlet .container later, add `UserNS=keep-id` + `User=1000`
#   and drop `:U`/`:Z` per docs/research/R_PODMAN_SOVEREIGN_V2.md.

[Unit]
Description=Omega Ark Blueprint Optimizer — Daily Drift & Integrity Verification
Documentation=https://github.com/Xoe-NovAi/omega-engine

[Service]
Type=oneshot
ExecStart=%h/Documents/Xoe-NovAi/omega-engine/.venv/bin/python3 \
    %h/Documents/Xoe-NovAi/omega-engine/scripts/ark_optimizer.py
WorkingDirectory=%h/Documents/Xoe-NovAi/omega-engine
Environment=PYTHONPATH=%h/Documents/Xoe-NovAi/omega-engine/src
Environment=OMEGA_ENV=production
# Read-only on sources; write-only to the report path under data/
ReadWritePaths=%h/Documents/Xoe-NovAi/omega-engine/data
ProtectSystem=full
PrivateTmp=yes
NoNewPrivileges=yes
MemoryMax=256M
MemoryHigh=192M

[Install]
WantedBy=default.target
