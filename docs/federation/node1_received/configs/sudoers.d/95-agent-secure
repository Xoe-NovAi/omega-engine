# Command aliases for agent workflow
Cmnd_Alias AGENT_APT = /usr/bin/apt, /usr/bin/apt-get, /usr/bin/apt-cache
Cmnd_Alias AGENT_SYSTEMCTL = /usr/bin/systemctl, /usr/bin/journalctl
Cmnd_Alias AGENT_BUILD = /usr/bin/make, /usr/bin/cmake, /usr/bin/ninja
Cmnd_Alias AGENT_GIT = /usr/bin/git
Cmnd_Alias AGENT_PYTHON = /usr/bin/python3, /usr/bin/pip3, /usr/bin/pipx
Cmnd_Alias AGENT_OLLAMA = /usr/bin/ollama, /usr/local/bin/ollama
Cmnd_Alias AGENT_DOCKER = /usr/bin/docker, /usr/bin/docker-compose
Cmnd_Alias AGENT_NET = /usr/bin/ip, /usr/bin/ss, /usr/bin/nmap

Defaults:xnai timestamp_timeout=15, tty_tickets

xnai ALL=(root) NOPASSWD: AGENT_APT, AGENT_SYSTEMCTL, AGENT_BUILD, AGENT_GIT, AGENT_PYTHON, AGENT_OLLAMA, AGENT_DOCKER, AGENT_NET

xnai ALL=(root) NOPASSWD: /usr/bin/pkexec
