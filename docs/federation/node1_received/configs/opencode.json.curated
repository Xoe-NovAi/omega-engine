{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "omega-hub": {
      "type": "remote",
      "url": "http://192.168.10.168:8016/mcp",
      "enabled": true
    },
    "searxng": {
      "type": "remote",
      "url": "http://127.0.0.1:8018/mcp",
      "enabled": true
    },
    "websearch": {
      "type": "remote",
      "url": "https://api.exa.ai/mcp",
      "enabled": true,
      "headers": {
        "Authorization": "Bearer {env:EXA_API_KEY}"
      }
    },
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp",
      "enabled": true
    },
    "grep_app": {
      "type": "remote",
      "url": "https://mcp.grep.app",
      "enabled": true
    },
    "mempalace": {
      "type": "local",
      "command": "/home/xnai/WanderGround/.venv/bin/mempalace-mcp",
      "args": [
        "--palace",
        "/home/xnai/WanderGround/mempalace"
      ],
      "enabled": true
    }
  },
  "plugin": [
    "/home/xnai/Vanguard/ponytail/.opencode/plugins/ponytail.mjs"
  ],
  "tools": {
    "library_search": false,
    "library_web_search": false,
    "search_extract": false,
    "search_status": false,
    "hivemind_submit_handoff": false,
    "hivemind_accept_handoff": false,
    "hivemind_complete_handoff": false,
    "hivemind_reject_handoff": false,
    "hivemind_handoff_list": false,
    "hivemind_get_handoff": false,
    "hivemind_handoff_archive": false,
    "library_inbox_add_url": false,
    "library_inbox_add_note": false,
    "library_inbox_add_file": false,
    "library_inbox_list": false,
    "library_inbox_stats": false,
    "library_ingest_pending": false,
    "library_index_flush": false,
    "library_discovery_research": false,
    "library_discovery_start": false,
    "library_discovery_status": false,
    "get_system_stats": false,
    "get_hardware_stats": false,
    "get_omega_metrics": false,
    "hivemind_get_metrics": false,
    "oracle_list_pillar_keepers": false,
    "oracle_list_entities": false,
    "oracle_summon": false,
    "oracle_summon_local": false,
    "oracle_talk": false,
    "github_create_pr_with_template": false,
    "github_check_temple_grade": false,
    "github_add_entity_attribution": false,
    "github_list_heritage_issues": false,
    "github_create_vet_issue": false,
    "github_get_repo_health": false
  }
}
