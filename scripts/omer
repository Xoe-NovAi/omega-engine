#!/usr/bin/env bash
# OMER (Omega Model Evaluation Registry) CLI Dispatcher
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="$(cd "${SCRIPT_DIR}/.." && pwd)"
VENV_PY="${REPO_ROOT}/.venv/bin/python3"

if [ ! -x "${VENV_PY}" ]; then
  echo "Error: Virtual environment not found at ${REPO_ROOT}/.venv" >&2
  echo "Run 'make python-setup' or configure .venv" >&2
  exit 1
fi

case "${1:-}" in
  validate)
    shift
    exec "${VENV_PY}" "${SCRIPT_DIR}/validate_model_cards.py" "$@"
    ;;
  *)
    echo "Omega Model Evaluation Registry (OMER) CLI"
    echo "Usage: omer <command> [options]"
    echo ""
    echo "Commands:"
    echo "  validate [paths...]   Validate model card frontmatter & structure against OMER v1.0 schema"
    echo ""
    exit 1
    ;;
esac
