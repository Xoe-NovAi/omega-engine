{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "encoder_eval baseline result",
  "type": "object",
  "required": ["encoder", "model_dir", "method", "roles"],
  "properties": {
    "encoder": { "type": "string" },
    "model_dir": { "type": "string" },
    "method": { "type": "string" },
    "max_len": { "type": "integer" },
    "seed": { "type": "integer" },
    "roles": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["role"],
        "properties": {
          "role": { "type": "string" },
          "error": { "type": "string" },
          "n_train": { "type": "integer" },
          "n_holdout": { "type": "integer" },
          "classes_train": { "type": "array", "items": { "type": "string" } },
          "accuracy": { "type": "number" },
          "macro_f1": { "type": "number" },
          "per_class_f1": { "type": "object" },
          "majority_floor_acc": { "type": "number" },
          "beats_floor": { "type": "boolean" },
          "latency_ms_p50": { "type": "number" },
          "latency_ms_p95": { "type": "number" },
          "latency_gate_ms": { "type": "number" },
          "latency_gate_pass": { "type": "boolean" },
          "insufficient_data": { "type": "boolean" }
        }
      }
    }
  }
}
