# Omega Engine Alpha — Ollama environment profile (CPU-only, 16GB)
# Source of truth for make env-setup / make env-apply.
# Apply with:  make env-setup   (or)   make env-apply FILE=.env.ollama

# Bind all interfaces so the Open WebUI container can reach Ollama
# via host.docker.internal (host-gateway). Local-only otherwise.
OLLAMA_HOST=0.0.0.0:11434

# Single-user CPU box: process one request at a time per model
OLLAMA_NUM_PARALLEL=1

# Keep two models warm (e.g. chat + embed) without exhausting RAM
OLLAMA_MAX_LOADED_MODELS=1

# Reload model only if idle for 30m — avoids cold-start tax on 16GB RAM
OLLAMA_KEEP_ALIVE=30m

# i7-13620H hybrid: 6 P-cores (12 logical, CPUs 0-11) + 4 E-cores (CPUs 12-15).
# In inference we exclude E-cores and stay on P-cores 0-11 (see AllowedCPUs in
# Makefile env-apply). Ollama already defaults to 1 thread per physical core and
# avoids thrashing on hyperthreads; 8 threads (physical+2) measures fastest here.
# IMPORTANT: do NOT narrow AllowedCPUs to the 6 physical cores {0,2,4,6,8,10} —
# llama-server spawns ~29 threads and starving them onto 6 CPUs causes a
# spin-wait barrier convoy that collapses throughput to ~0.5 t/s (ollama #17916).
OLLAMA_NUM_THREADS=8

# Cap default context window: phi4-mini advertises 128k, which would OOM the
# KV cache on 16GB single-channel CPU if actually filled. 8192 covers chat/code
# comfortably; raise per-request via {"options":{"num_ctx":N}} when needed.
OLLAMA_CONTEXT_LENGTH=8192

# Quantize the KV cache to 8-bit: roughly halves KV memory (~0.5-1GB at 8k ctx
# on 7B models) with minimal quality impact. Frees RAM for a warmer working set.
OLLAMA_KV_CACHE_TYPE=q8_0

# Enable flash attention. Our runner already passes --flash-attn auto; forcing
# =1 prevents any silent fallback and helps most at longer contexts.
OLLAMA_FLASH_ATTENTION=1

# Stay fully local: disable Ollama cloud models / web search
OLLAMA_NO_CLOUD=1

# Open WebUI login-session secret (persists across redeploys)
WEBUI_SECRET_KEY=<REDACTED-SET-YOUR-OWN>