# 🔱 Omega Engine — YouTube Background Worker (Daemon Service)
# ⬡ OMEGA ⬡ SOPHIA ⬡ autonomous ⬡ youtube_worker ⬡ WORKER
#
# Runs the sovereign YouTube ingestion and synthesis daemon.
#   - Inner watchdog: crash-loop breaker with exponential backoff.
#   - systemd Restart=on-failure: outer watchdog if process dies.
#   - CPU ceiling: throttles when system CPU > 85%.
#   - Kill switch: SIGTERM/SIGINT for clean shutdown between cycles.

[Unit]
Description=Omega YouTube Worker — Sovereign YouTube Ingestion & Synthesis
Documentation=https://github.com/Xoe-NovAi/omega-engine
After=network-online.target omega-searxng.service redis.service
Wants=network-online.target
Requires=omega-searxng.service

[Service]
Type=simple
ExecStart=%h/Documents/Xoe-NovAi/omega-engine/.venv/bin/python3 -m omega.workers.youtube_worker --daemon --cpu-ceiling 85 --interval 5
WorkingDirectory=%h/Documents/Xoe-NovAi/omega-engine
Environment=PYTHONPATH=%h/Documents/Xoe-NovAi/omega-engine/src
Environment=OMEGA_ENV=production
Environment=MALLOC_MMAP_THRESHOLD_=65536
Environment=MALLOC_ARENA_MAX=2

# Logs
StandardOutput=append:/home/arcana-novai/Documents/Xoe-NovAi/omega-engine/data/entities/roc_racoon/workspace/HALL_OF_RECORDS/youtube-worker/output.log
StandardError=append:/home/arcana-novai/Documents/Xoe-NovAi/omega-engine/data/entities/roc_racoon/workspace/HALL_OF_RECORDS/youtube-worker/error.log

# Memory protection (YouTube transcripts + synthesis can be memory-hungry)
MemoryMax=768M
MemoryHigh=512M

# Outer watchdog: restart on crash
Restart=on-failure
RestartSec=30s

# Security hardening
ProtectSystem=full
ReadWritePaths=%h/Documents/Xoe-NovAi/omega-engine/data %h/Documents/Xoe-NovAi/omega-engine/docs
PrivateTmp=yes
NoNewPrivileges=yes

[Install]
WantedBy=default.target
