# 🔱 Omega Engine — Background Research Service (Daemon + Watchdog)
# ⬡ OMEGA ⬡ SOPHIA ⬡ autonomous ⬡ research ⬡ WORKER
#
# Runs the sovereign background researcher as a CONTINUOUS daemon.
#   - Inner watchdog (crash-loop breaker) restarts cycles on failure.
#   - systemd Restart=on-failure provides the OUTER watchdog if the process dies.
# API keys resolve from the sovereign vault at runtime — never from plaintext .env.

[Unit]
Description=Omega Background Researcher — Sovereign Research Worker (Daemon)
Documentation=https://github.com/Xoe-NovAi/omega-engine
After=network-online.target omega-searxng.service
Wants=network-online.target
Requires=omega-searxng.service

[Service]
Type=simple
ExecStart=%h/Documents/Xoe-NovAi/omega-engine/.venv/bin/python3 -m omega.workers.background_researcher.run --daemon
WorkingDirectory=%h/Documents/Xoe-NovAi/omega-engine
Environment=PYTHONPATH=%h/Documents/Xoe-NovAi/omega-engine/src
# Non-secret config only (SEARXNG_BASE_URL). API keys resolve from the
# sovereign vault at runtime — never from plaintext .env.
EnvironmentFile=%h/Documents/Xoe-NovAi/omega-engine/.env
Environment=OMEGA_ENV=production
Environment=MALLOC_MMAP_THRESHOLD_=65536
Environment=MALLOC_ARENA_MAX=2
StandardOutput=append:/home/arcana-novai/Documents/Xoe-NovAi/omega-engine/data/entities/roc_racoon/workspace/HALL_OF_RECORDS/background-researcher/output.log
StandardError=append:/home/arcana-novai/Documents/Xoe-NovAi/omega-engine/data/entities/roc_racoon/workspace/HALL_OF_RECORDS/background-researcher/error.log

# Memory protection
MemoryMax=512M
MemoryHigh=384M

# Outer watchdog: restart the process if it exits non-zero (e.g. crash-loop abort)
Restart=on-failure
RestartSec=30s

# Security hardening
ProtectSystem=full
ReadWritePaths=%h/Documents/Xoe-NovAi/omega-engine/data %h/Documents/Xoe-NovAi/omega-engine/docs
PrivateTmp=yes
NoNewPrivileges=yes

[Install]
WantedBy=default.target
